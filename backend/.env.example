# Copy this file to .env (and load it, e.g. with `python -m dotenv run` or your
# host's env-var settings) before deploying SkillBridge AI publicly.

# The only thing you really need in production: a persistent database.
# Without it the app falls back to a local SQLite file, which on Vercel lives in
# /tmp and is wiped on every cold start — so users get logged out and data
# disappears. Create a Postgres database (Vercel Storage -> Neon) and connect it
# to the project; the connection string is provided automatically.
# POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: the key used to sign login sessions. If you leave this unset the app
# generates a strong random secret on first run and stores it in the database,
# which is secure and survives restarts — so you normally don't need to set it.
# Set it explicitly only if you want to control the value yourself. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SKILLBRIDGE_SECRET=a-long-random-value

# Secure cookies turn on automatically on Vercel (HTTPS). Only set this to
# "true" if you serve the app over HTTPS somewhere else. Leave it unset for
# local http development, otherwise the browser won't store the login cookie.
# SKILLBRIDGE_SECURE_COOKIES=true

# Optional: "Sign in with Google". The button only appears when both of these
# are set, so leaving them empty simply hides it.
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create
#      credentials -> OAuth client ID -> "Web application".
#   2. Authorised redirect URI: https://<your-domain>/api/auth/google/callback
#   3. Copy the client ID and secret here (or into Vercel's env settings).
# The secret is only ever used server-side; it is never sent to the browser.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Pin the redirect URI if the derived one doesn't match what you registered:
# GOOGLE_REDIRECT_URI=https://skillbridge-ai-ashy.vercel.app/api/auth/google/callback
