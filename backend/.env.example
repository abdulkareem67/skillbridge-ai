# Copy this file to .env (and load it, e.g. with `python -m dotenv run` or your
# host's env-var settings) before deploying SkillBridge AI publicly.

# Required in production: signs JWT session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SKILLBRIDGE_SECRET=change-me-to-a-long-random-value

# Set to "true" once the app is served over HTTPS so the session cookie is
# only ever sent over an encrypted connection. Leave "false" for local http
# development, otherwise the login cookie won't be set by the browser.
SKILLBRIDGE_SECURE_COOKIES=false
