# Copy this file to .env (and load it, e.g. with `python -m dotenv run` or your
# host's env-var settings) before deploying SkillBridge AI publicly.

# Required in production: signs JWT session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SKILLBRIDGE_SECRET=change-me-to-a-long-random-value

# Persistent database (production). Without this the app uses a local SQLite
# file, which on Vercel lives in /tmp and is wiped on every cold start — so
# users and data disappear. Create a Postgres database (Vercel Storage / Neon)
# and it will provide POSTGRES_URL automatically; the app uses it when present.
# POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Secure cookies turn on automatically on Vercel (HTTPS). Only set this to
# "true" if you serve the app over HTTPS somewhere else. Leave it unset for
# local http development, otherwise the browser won't store the login cookie.
# SKILLBRIDGE_SECURE_COOKIES=true
